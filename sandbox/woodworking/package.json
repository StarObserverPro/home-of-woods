{
  "name": "@home-of-woods/woodworking",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "森林之家 · 游戏化工作台、立体选面与有限锯切",
  "files": [
    "dist/woodworking.js",
    "dist/types",
    "README.md",
    "dist/THIRD_PARTY_NOTICES.txt"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/sandbox/woodworking/src/index.d.ts",
      "import": "./dist/woodworking.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.host.json && node tools/build.mjs",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
