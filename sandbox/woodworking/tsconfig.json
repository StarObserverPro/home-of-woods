{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "verbatimModuleSyntax": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true, "declaration": true, "emitDeclarationOnly": true,
    "rootDir": "../..", "outDir": "dist/types"
  },
  "include": ["src"]
}
