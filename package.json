{
  "name": "home-of-woods",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && tsc -p sandbox/cabin-interior/tsconfig.json && vite build",
    "dev:cabin": "vite --open /sandbox/cabin-interior/",
    "test:cabin": "node --experimental-strip-types --test tests/cabin-interior.test.ts",
    "verify:cabin-assets": "node tools/verify-cabin-assets.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "verify:assets": "node tools/verify-assets.mjs",
    "check": "npm run verify:assets && npm test && npm run build",
    "verify:evidence": "node tools/run-archived-evidence-audits.mjs",
    "freeze:runtime": "node tools/freeze-runtime.mjs",
    "verify:ui": "node tools/verify-ui-contract.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.65.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
