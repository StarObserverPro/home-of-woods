{
  "name": "home-of-woods",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "verify:assets": "node tools/verify-assets.mjs",
    "check": "npm run verify:assets && npm test && npm run build",
    "verify:evidence": "node tools/audit-evidence.mjs",
    "freeze:runtime": "node tools/freeze-runtime.mjs"
  },
  "dependencies": {
    "three": "0.186.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/three": "0.185.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
